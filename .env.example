# Copy to .env and adjust. Every setting is optional.

# Network interface and port. 0.0.0.0 = reachable from other devices on your network.
HOST=0.0.0.0
PORT=8080

# Where the SQLite database file lives (created automatically).
DATABASE_PATH=data/ledger.db

# Initial GM account, used only the first time the server starts with an empty database.
# If GM_PASSWORD is not set, a random password is generated and printed once.
GM_USERNAME=gm
GM_PASSWORD=

# Online deployments: the public address players use. Enables Secure cookies when https.
# PUBLIC_URL=https://ledger.example.com

# Set to true when running behind a reverse proxy (Caddy, nginx, a hosting platform)
# so the real client IP and https scheme are recognised.
# TRUST_PROXY=true

# Serve HTTPS directly instead of using a reverse proxy.
# TLS_CERT_FILE=/path/to/fullchain.pem
# TLS_KEY_FILE=/path/to/privkey.pem

# Force Secure cookies on or off (default: on when PUBLIC_URL is https or TLS is configured).
# COOKIE_SECURE=true

# Extra allowed browser origins, comma separated (rarely needed).
# ALLOWED_ORIGINS=https://other.example.com

# How long a login lasts, in hours (default 336 = 14 days; extended while in use).
# SESSION_TTL_HOURS=336

# Maximum uploaded image size in KB (default 2048).
# MAX_IMAGE_KB=2048
