{
  "name": "the-ledger",
  "version": "1.1.0",
  "private": true,
  "description": "The Ledger: server-authoritative multiplayer inventory and asset transfer system for roleplaying games",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "node scripts/build-client.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "dev": "node scripts/dev.mjs",
    "test": "tsx --test --test-concurrency=1 --test-reporter=spec server/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "reset-gm-password": "node --disable-warning=ExperimentalWarning dist/server/cli/reset-gm-password.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
